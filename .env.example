# Скопируйте этот файл в .env и заполните значения.
# Файл .env в репозиторий не попадает (см. .gitignore).

# Ключ API Кинопоиска (https://kinopoisk.dev)
KINOPOISK_API_KEY=ваш_ключ_api

# Необязательные настройки (по умолчанию берутся из conftest.py):
# KINOPOISK_BASE_URL=https://www.kinopoisk.ru
# KINOPOISK_API_BASE_URL=https://api.poiskkino.dev
# HEADLESS=0
# KINOPOISK_AUTH_COOKIES=.auth/cookies.json
# KINOPOISK_AUTO_LOGIN=1
# KINOPOISK_AUTH_TIMEOUT=300
